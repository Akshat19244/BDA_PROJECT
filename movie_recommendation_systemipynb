      "source": [
        "import ast\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "\n",
        "def get_genres(genres_str):\n",
        "    if isinstance(genres_str, str):\n",
        "        try:\n",
        "            genres_list = ast.literal_eval(genres_str)\n",
        "            if isinstance(genres_list, list):\n",
        "                return ' '.join([g['name'] for g in genres_list if 'name' in g])\n",
        "        except (ValueError, SyntaxError):\n",
        "            pass\n",
        "    return ''\n",
        "\n",
        "CSV_PATH = '/content/drive/MyDrive/content/movies_metadata.csv'\n",
        "\n",
        "# Load once, clean id\n",
        "df_raw = pd.read_csv(CSV_PATH, low_memory=False)\n",
        "df_raw['id'] = pd.to_numeric(df_raw['id'], errors='coerce')\n",
        "df_raw = df_raw.dropna(subset=['id'])\n",
        "df_raw['id'] = df_raw['id'].astype(int)\n",
        "df_raw = df_raw.reset_index(drop=True)\n",
        "\n",
        "# Load meta (vote_count, vote_average)\n",
        "meta = pd.read_csv(CSV_PATH, usecols=['id', 'vote_count', 'vote_average'], low_memory=False)\n",
        "meta['id'] = pd.to_numeric(meta['id'], errors='coerce')\n",
        "meta = meta.dropna(subset=['id'])\n",
        "meta['id'] = meta['id'].astype(int)\n",
        "\n",
        "# Merge — this is now the ONE dataframe used everywhere\n",
        "df_rated = df_raw.merge(meta, on='id', how='left').reset_index(drop=True)\n",
        "\n",
        "df_rated['vote_count']   = pd.to_numeric(df_rated['vote_count_y'],   errors='coerce').fillna(0)\n",
        "df_rated['vote_average'] = pd.to_numeric(df_rated['vote_average_y'], errors='coerce').fillna(0)\n",
        "\n",
        "# Tags for TF-IDF\n",
        "df_rated['genres_processed'] = df_rated['genres'].apply(get_genres)\n",
        "df_rated['tags'] = (df_rated['overview'].fillna('')    + ' ' +\n",
        "                    df_rated['tagline'].fillna('')      + ' ' +\n",
        "                    df_rated['title'].fillna('')        + ' ' +\n",
        "                    df_rated['genres_processed'].fillna(''))\n",
        "\n",
        "# Weighted rating\n",
        "m = df_rated['vote_count'].quantile(0.70)\n",
        "C = df_rated['vote_average'].mean()\n",
        "\n",
        "def weighted_rating(row, m=m, C=C):\n",
        "    v, R = row['vote_count'], row['vote_average']\n",
        "    return round((v / (v + m)) * R + (m / (v + m)) * C, 4)\n",
        "\n",
        "df_rated['weighted_score'] = df_rated.apply(weighted_rating, axis=1)\n",
        "\n",
        "# TF-IDF — built from df_rated only\n",
        "tfidf        = TfidfVectorizer(max_features=10000, stop_words='english')\n",
        "tfidf_matrix = tfidf.fit_transform(df_rated['tags'].fillna(''))\n",
        "title_to_idx = pd.Series(df_rated.index, index=df_rated['title'].str.lower()).drop_duplicates()\n",
        "\n",
        "print(f'df_rated shape : {df_rated.shape}')\n",
        "print(f'tfidf_matrix   : {tfidf_matrix.shape}')\n",
        "assert tfidf_matrix.shape[0] == len(df_rated), (\n",
        "    f\" Shape mismatch: tfidf_matrix={tfidf_matrix.shape[0]} vs df_rated={len(df_rated)}\\n\"\n",
        "    f\"   Re-run Cell 2 from scratch (Runtime > Restart & Run All)\"\n",
        ")\n",
        "print(f' df_rated: {len(df_rated):,} rows | tfidf_matrix: {tfidf_matrix.shape} ← must match')"
      ]
