        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "def content_recommend(title, n=10):\n",
        "    title_lower = title.lower()\n",
        "    if title_lower not in title_to_idx:\n",
        "        return f\" '{title}' not found.\"\n",
        "\n",
        "    idx        = title_to_idx[title_lower]\n",
        "    sim_scores = cosine_similarity(tfidf_matrix[idx], tfidf_matrix).flatten()\n",
        "    sim_scores[idx] = 0\n",
        "\n",
        "    # Clip to valid df_rated bounds in case of any residual mismatch\n",
        "    top = np.argsort(sim_scores)[::-1]\n",
        "    top = top[top < len(df_rated)][:n]   # ← the key guard\n",
        "\n",
        "    results = df_rated.iloc[top][['title']].copy()\n",
        "    results['similarity_score'] = sim_scores[top].round(4)\n",
        "    results.insert(0, 'rank', range(1, len(top) + 1))\n",
        "    return results.reset_index(drop=True)\n",
        "\n",
        "print(' Content-Based Recommender Ready')\n",
        "content_recommend('The Dark Knight', n=10)"
      ]
