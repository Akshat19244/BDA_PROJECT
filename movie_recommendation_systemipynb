        "def hybrid_recommend(user_id, movie_title, n=10,\n",
        "                     w_content=0.4, w_collab=0.4, w_chart=0.2):\n",
        "    title_lower = movie_title.lower()\n",
        "    if title_lower not in title_to_idx:\n",
        "        return f\" '{movie_title}' not found.\"\n",
        "\n",
        "    # Get the integer index (ensuring we only take one if duplicates exist)\n",
        "    idx = title_to_idx[title_lower]\n",
        "    if isinstance(idx, pd.Series):\n",
        "        idx = idx.iloc[0]\n",
        "\n",
        "    # 1. Content Scores (N,)\n",
        "    sim_scores = cosine_similarity(tfidf_matrix[idx], tfidf_matrix).flatten()\n",
        "\n",
        "    # 2. Collaborative Scores (N,)\n",
        "    # We map predictions directly to the index of df_rated to ensure shape matches\n",
        "    collab_scores = np.array([\n",
        "        svd_model.predict(user_id, mid).est for mid in df_rated['id']\n",
        "    ])\n",
        "\n",
        "    # 3. Chart Scores (N,)\n",
        "    chart_scores = df_rated['weighted_score'].values\n",
        "\n",
        "    def minmax(arr):\n",
        "        mn, mx = arr.min(), arr.max()\n",
        "        return (arr - mn) / (mx - mn + 1e-9)\n",
        "\n",
        "    # Ensure all shapes match the dataframe length\n",
        "    N = len(df_rated)\n",
        "    sim_scores = sim_scores[:N]\n",
        "    collab_scores = collab_scores[:N]\n",
        "    chart_scores = chart_scores[:N]\n",
        "\n",
        "    hybrid = (w_content * minmax(sim_scores) +\n",
        "              w_collab  * minmax(collab_scores) +\n",
        "              w_chart   * minmax(chart_scores))\n",
        "\n",
        "    # Exclude the seed movie itself\n",
        "    hybrid[idx] = 0\n",
        "\n",
        "    top = np.argsort(hybrid)[::-1][:n]\n",
        "    results = df_rated.iloc[top][['title']].copy()\n",
        "    results['hybrid_score'] = hybrid[top].round(4)\n",
        "    results['content_sim'] = sim_scores[top].round(4)\n",
        "    results['predicted_rating'] = collab_scores[top].round(4)\n",
        "    results['weighted_score'] = chart_scores[top].round(4)\n",
        "    results.insert(0, 'rank', range(1, len(top) + 1))\n",
        "    return results.reset_index(drop=True)\n",
        "\n",
        "print(' Hybrid Recommender Updated with Shape Protection')"
      ]
    },
